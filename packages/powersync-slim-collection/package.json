{
  "name": "@tanstack/powersync-slim-collection",
  "version": "0.0.0",
  "description": "Slim PowerSync collection for TanStack DB",
  "author": "POWERSYNC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/db.git",
    "directory": "packages/powersync-slim-collection"
  },
  "homepage": "https://tanstack.com/db",
  "keywords": [
    "powersync",
    "realtime",
    "local-first",
    "sync-engine",
    "sync",
    "typescript"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --fix",
    "test": "vitest --run"
  },
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@tanstack/db": "workspace:*",
    "@powersync/standalone-client": "^0.1.0"
  }
}
